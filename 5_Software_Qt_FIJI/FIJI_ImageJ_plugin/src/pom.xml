<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0   http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>13.0.0</version>
	</parent>

	<groupId>jp.utokyo.tsukayalab</groupId>
	<artifactId>UTokyo.TsukayaLab.WangZining</artifactId>
	<version>Cell-Division-Inference-FIJI-plugin</version>

	<name>Cell Division Inference</name>
	<description>This plugin is for inferring cell division based on cell shapes</description>
	<url>https://www.bs.s.u-tokyo.ac.jp/~bionev2/</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>Tsukaya Lab in The University of Tokyo</name>
		<url>https://www.bs.s.u-tokyo.ac.jp/~bionev2/</url>
	</organization>
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<!-- See https://imagej.net/Team -->
		<developer>
			<id>wang</id>
			<name>WangZining</name>
			<url>to be released</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>

	<contributors>
		<contributor>
			<name>None</name>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>ImageJ Forum</name>
			<archive>https://forum.imagej.net/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>https://www.bs.s.u-tokyo.ac.jp/~bionev2/</connection>
		<developerConnection>https://www.bs.s.u-tokyo.ac.jp/~bionev2/</developerConnection>
		<tag>HEAD</tag>
		<url>https://www.bs.s.u-tokyo.ac.jp/~bionev2/</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://www.bs.s.u-tokyo.ac.jp/~bionev2/</url>
	</issueManagement>
	<ciManagement>
		<system>None</system>
	</ciManagement>

	<properties>
		<package-name>jp.utokyo.tsukayalab</package-name>
		<main-class>jp.utokyo.tsukayalab.CellDivisionInferring</main-class>
		
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<maven.compiler.release>8</maven.compiler.release>
		<gson.version>2.8.5</gson.version>
		<jgrapht.version>1.4.0</jgrapht.version>
  
		<license.licenseName>bsd_2</license.licenseName>
		<license.copyrightOwners>Tsukaya Lab in The University of Tokyo.</license.copyrightOwners>
	</properties>

	<repositories>
		<repository>
			<id>imagej.public</id>
			<url>https://maven.imagej.net/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- Fiji already provides ImageJ; don't bundle it -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- JSON -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>${gson.version}</version>
		</dependency>

		<!-- Graph library -->
		<dependency>
			<groupId>org.jgrapht</groupId>
			<artifactId>jgrapht-core</artifactId>
			<version>${jgrapht.version}</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>Cell-Division-Inference-FIJI-plugin</finalName>
		<plugins>
			<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-shade-plugin</artifactId>
			<version>3.5.1</version>

			<executions>
				<execution>
				<phase>package</phase>
				<goals>
					<goal>shade</goal>
				</goals>
				<configuration>
					<!-- Replace the normal jar with the shaded one -->
					<shadedArtifactAttached>false</shadedArtifactAttached>
					<createDependencyReducedPom>false</createDependencyReducedPom>

					<!-- Avoid signature file warnings -->
					<filters>
					<filter>
						<artifact>*:*</artifact>
						<excludes>
						<exclude>META-INF/*.SF</exclude>
						<exclude>META-INF/*.DSA</exclude>
						<exclude>META-INF/*.RSA</exclude>
						</excludes>
					</filter>
					</filters>

					<!-- OPTIONAL but recommended: prevent conflicts if other plugins ship gson/jgrapht -->
					<relocations>
					<relocation>
						<pattern>com.google.gson</pattern>
						<shadedPattern>jp.utokyo.tsukayalab.shaded.gson</shadedPattern>
					</relocation>
					<relocation>
						<pattern>org.jgrapht</pattern>
						<shadedPattern>jp.utokyo.tsukayalab.shaded.jgrapht</shadedPattern>
					</relocation>
					<relocation>
						<pattern>org.jheaps</pattern>
						<shadedPattern>jp.utokyo.tsukayalab.shaded.jheaps</shadedPattern>
					</relocation>
					</relocations>
				</configuration>
				</execution>
			</executions>
			</plugin>
		</plugins>
	</build>

</project>
